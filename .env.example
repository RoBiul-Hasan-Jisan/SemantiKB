# Copy this file to .env and adjust as needed.

# --- Paths -------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
VECTOR_DB_PATH=./data/chroma
SQLITE_PATH=./data/sqlite/pka.db

# --- Embedding model -----------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Semantic chunking (the core tunables) --------------------------------
# Lower threshold -> fewer, larger chunks (only very strong topic shifts split).
# Higher threshold -> more, smaller chunks (splits on subtler topic shifts).
CHUNK_SIMILARITY_THRESHOLD=0.65
CHUNK_MIN_SIZE_TOKENS=80
CHUNK_MAX_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=30
PREFER_PARAGRAPH_BOUNDARIES=true

# --- Baseline chunkers (for comparison/evaluation) ------------------------
FIXED_CHUNK_SIZE_TOKENS=250
FIXED_CHUNK_OVERLAP_TOKENS=30
RECURSIVE_CHUNK_SIZE_TOKENS=250
RECURSIVE_CHUNK_OVERLAP_TOKENS=30

# --- Retrieval -------------------------------------------------------------
TOP_K=5
RETRIEVAL_MODE=hybrid
HYBRID_ALPHA=0.5

# --- Reranking  ---------------------------------------------------
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20

# --- Summarization -----------------------------------------------------------
ENABLE_HIERARCHICAL_SUMMARIZATION=true
SUMMARY_MAX_TOKENS=200

# --- Ollama ------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.1
LLM_CONTEXT_MAX_TOKENS=4000

# --- App ------------------------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
